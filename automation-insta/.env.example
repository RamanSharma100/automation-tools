# Instagram Login Credentials
# Option A: Username & Password
INSTA_USERNAME=your_instagram_username
INSTA_PASSWORD=your_instagram_password

# Option B: Browser sessionid cookie (100% bypasses SMS, email, and 2FA prompts)
# Found in: Browser DevTools (F12) -> Application -> Cookies -> instagram.com -> sessionid
INSTA_SESSIONID=

# Optional: Proxy (HTTP or SOCKS5) e.g., http://user:pass@proxy_host:port
INSTA_PROXY=

# Safety & Rate Limiting (in seconds)
DELAY_MIN=20
DELAY_MAX=40
BATCH_SIZE=5
BATCH_REST_MIN=45
BATCH_REST_MAX=90

# Maximum unfollows / follower removals per session (Instagram safety cap)
MAX_ACTIONS_PER_RUN=25

# Safety options
SKIP_VERIFIED=true
SKIP_PRIVATE=false

